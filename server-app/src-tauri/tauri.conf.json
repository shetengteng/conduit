{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conduit Server",
  "version": "0.2.3",
  "identifier": "com.terrellshe.conduit.server",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @conduit/server-ui dev",
    "beforeBuildCommand": "pnpm --filter @conduit/server-ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Conduit Server",
        "width": 1200,
        "height": 720,
        "minWidth": 880,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Share LAN VPN access through Conduit",
    "longDescription": "Conduit lets you share your VPN connection over the local network with other devices.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
