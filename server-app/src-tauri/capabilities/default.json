{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Conduit Server: window mgmt, event listen, IPC commands, opener for external URLs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:allow-version",
    "opener:default"
  ]
}
