{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Conduit Client: window mgmt, event listen, IPC commands, shell open.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:allow-version",
    "shell:allow-open"
  ]
}
