{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conduit Client",
  "version": "0.1.4",
  "identifier": "com.terrellshe.conduit.client",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm --filter @conduit/client-ui dev",
    "beforeBuildCommand": "pnpm --filter @conduit/client-ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Conduit Client",
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "binaries-dir/conduit-client-sidecar/": "binaries-dir/conduit-client-sidecar/"
    },
    "category": "Utility",
    "shortDescription": "Use a Conduit Server's VPN through your LAN",
    "longDescription": "Conduit Client connects you to a Conduit Server on your LAN and intelligently routes traffic locally or through the server's VPN."
  }
}
